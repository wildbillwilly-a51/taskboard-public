# Generate each value independently with: openssl rand -hex 32
# Use hex for POSTGRES_PASSWORD because it is also used in a connection URL.
POSTGRES_PASSWORD=
AUTH_SECRET=

# Optional settings for the app listener and HTTPS session cookies.
# TASKBOARD_BIND_ADDRESS=127.0.0.1
# TASKBOARD_PORT=3000
# AUTH_COOKIE_SECURE=false

# Optional OpenID Connect sign-in. Set all four values to enable it.
# TASKBOARD_OIDC_ISSUER=https://id.example.com
# TASKBOARD_OIDC_CLIENT_ID=
# TASKBOARD_OIDC_CLIENT_SECRET=
# TASKBOARD_OIDC_CALLBACK_URL=https://taskboard.example.com/api/auth/oidc/callback
